# 复制为 backend/.env 后填入真实值（.env 已 gitignore）
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/inhaler_demo
JWT_SECRET=change-me-in-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI（可替换 LLM；密钥仅后端，绝不进 Git/APK）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20

# 任务扫描（单进程，默认 5 分钟）
TASK_SCAN_INTERVAL_SECONDS=300
